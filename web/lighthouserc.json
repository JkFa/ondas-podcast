{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --port 4174",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4174/",
        "http://localhost:4174/#/biblioteca",
        "http://localhost:4174/#/livro/o-livro-de-ruth",
        "http://localhost:4174/#/notas",
        "http://localhost:4174/#/salvos",
        "http://localhost:4174/#/downloads",
        "http://localhost:4174/#/assinar",
        "http://localhost:4174/#/publicar",
        "http://localhost:4174/#/estatisticas",
        "http://localhost:4174/#/backup"
      ],
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": [
          "accessibility"
        ],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
